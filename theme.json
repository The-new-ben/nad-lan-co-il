      "fontFamilies": [
        {
          "slug": "frank-ruhl-libre",
          "name": "Frank Ruhl Libre",
          "fontFamily": "\"Frank Ruhl Libre\", \"Cardo\", \"Georgia\", serif",
          "fontFace": [
            {
              "fontFamily": "Frank Ruhl Libre",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/frank-ruhl-libre/frl-400.woff2"
              ]
            },
            {
              "fontFamily": "Frank Ruhl Libre",
              "fontWeight": "500",
