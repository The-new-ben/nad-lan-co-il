{
	"name": "twentytwentyfive",
	"version": "1.5.0",
	"description": "Default WP Theme",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Theme"
	],
	"bugs": {
		"url": "https://core.trac.wordpress.org/"
	},
	"homepage": "https://wordpress.org/themes/twentytwentyfive/",
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.34.0",
		"cssnano": "^7.1.2",
		"playwright": "^1.61.1",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"build": "postcss style.css --use cssnano -o style.min.css --no-map",
		"watch": "postcss style.css --use cssnano -o style.min.css --no-map --watch",
		"qa:showroom-engine-preview": "node scripts/qa-showroom-engine-preview.mjs --strict",
		"qa:home-chrome": "node scripts/qa-home-chrome.mjs --strict",
		"qa:home-seo-schema": "node scripts/qa-home-seo-schema.mjs --strict",
		"qa:home-showroom-preview": "node scripts/qa-home-showroom-preview.mjs --strict",
		"qa:home-showroom-pattern": "node scripts/qa-home-showroom-pattern.mjs --strict",
		"qa:showroom-v2-preview": "node scripts/qa-showroom-v2-preview.mjs --strict",
		"qa:ashira-factory-readiness": "node scripts/qa-ashira-factory-readiness.mjs --strict",
		"qa:ashira-research-dossier": "node scripts/qa-ashira-research-dossier.mjs --strict",
		"qa:ashira-draft-readiness": "node scripts/qa-wp-draft-payload.mjs --draft docs/wp-drafts/ashira-sde-dov-v2-draft.json --payload assets/projects/ashira-sde-dov/showroom-payload.json --out docs/qa/ashira-v2-draft-readiness-report.json --strict"
	}
}
