{
	"name": "twentytwentyfive",
	"version": "1.5.0",
	"description": "Default WP Theme",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Theme"
	],
	"bugs": {
		"url": "https://core.trac.wordpress.org/"
	},
	"homepage": "https://wordpress.org/themes/twentytwentyfive/",
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@gltf-transform/cli": "^4.4.0",
		"@playwright/test": "^1.61.0",
		"@wordpress/browserslist-config": "^6.34.0",
		"cssnano": "^7.1.2",
		"lighthouse": "^13.4.0",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"build": "postcss style.css --use cssnano -o style.min.css --no-map",
		"watch": "postcss style.css --use cssnano -o style.min.css --no-map --watch",
		"qa:showroom:geometry": "node scripts/qa-showroom-geometry.mjs",
		"qa:showroom:visual": "node scripts/qa-project-showroom-visual.mjs",
		"qa:showroom:lighthouse": "lighthouse"
	}
}
