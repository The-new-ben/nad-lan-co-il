    },
    {
     "@type": "Question",
     "name": "Which complex is it?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The complex name and address were not published; Meital Katzir gives them on direct contact. Per the broker, the complex has a swimming pool, a gym, a guard and further services."
     }
    },
    {
     "@type": "Question",
     "name": "Does the Fair Rental Law apply?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "It does if the rent does not exceed about NIS 20,000 a month, as across the whole asking range for similar units nearby. Guarantees are then capped at the lower of 3 months' rent or a third of the total rent."
     }
    },
    {
     "@type": "Question",
     "name": "What is nearby?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Ramat Aviv has Tel Aviv University, Ramat Aviv Mall with about 140 stores, the Eretz Israel Museum and the Palmach Museum. Exact distances depend on the address."
