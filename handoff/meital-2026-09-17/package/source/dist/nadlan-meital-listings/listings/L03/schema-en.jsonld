    {
     "@type": "Question",
     "name": "What does the apartment cost per month?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "NIS 15,500, and with the management fee and arnona an estimated NIS 18,292 to 18,751 a month."
     }
    },
    {
     "@type": "Question",
     "name": "Which floor, and where does it look?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A high floor with an open view to the sea and across Tel Aviv; a January 2026 post gave floor 20. The balcony faces south-west."
     }
    },
    {
     "@type": "Question",
     "name": "Is there a pool?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No communal pool or spa appears in developer or contractor sources. The project has a residents' gym, 24/7 security and a double-height lobby."
     }
    },
    {
     "@type": "Question",
     "name": "How close is the light rail?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Exit A of Yehudit station on the Red Line serves the Sarona complex, and the line has run since August 2023."
     }
    },
    {
     "@type": "Question",
     "name": "What does the law say about guarantees?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "At rents up to NIS 20,000 the Fair Rental Law applies, and guarantees are capped at the lower of 3 months' rent or a third of the total rent: up to NIS 46,500 on a 12-month lease."
     }
    }
