    {
     "@type": "Question",
     "name": "What is the rent?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The rent is given on direct request. Eleven listings of 5-room sea or west-facing units in the project ask NIS 130 to 148 per built sqm, about NIS 16,640 to 18,944 a month for 128 sqm. This is a computation, not a quote."
     }
    },
    {
     "@type": "Question",
     "name": "What changed when it was converted to 4.5 rooms?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The apartment was planned as five rooms and converted to 4.5. Check the change and the integrity of the safe room on the unit plan."
     }
    },
    {
     "@type": "Question",
     "name": "Is there a pool?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No communal pool or spa appears in developer or contractor sources. The project has a residents' gym and 24/7 security."
     }
    },
    {
     "@type": "Question",
     "name": "How close is the light rail?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Exit A of Yehudit station on the Red Line serves the Sarona complex, and the line has run since August 2023."
     }
    },
    {
     "@type": "Question",
     "name": "Will the Fair Rental Law apply?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "If the rent is up to NIS 20,000 a month, the law applies and guarantees are capped at the lower of 3 months' rent or a third of the total rent."
     }
    }
