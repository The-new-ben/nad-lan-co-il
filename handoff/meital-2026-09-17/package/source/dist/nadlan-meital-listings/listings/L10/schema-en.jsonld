    {
     "@type": "Question",
     "name": "What does the apartment cost per month?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "NIS 9,500 per the broker's listings. With arnona as estimated, and before the building fee, which was not published, about NIS 10,332 to 10,536 a month."
     }
    },
    {
     "@type": "Question",
     "name": "How large is it, and on which floor?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Per the broker's Madlan listing: about 90 sqm plus a balcony of about 20 sqm, on floor 5 of a seven-floor building on pillars with a lift."
     }
    },
    {
     "@type": "Question",
     "name": "Is there a safe room and parking?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Per the broker, the unit has a safe room, two separate parking spaces and a large storage room near the parking."
     }
    },
    {
     "@type": "Question",
     "name": "How far is the sea?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "About five minutes on foot per the broker, next to the path to the sea. The coastal park promenade, about 2 km from Tel Baruch beach to Tzuk beach, opened in 2023."
     }
    },
    {
     "@type": "Question",
     "name": "What does the law say about guarantees?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "At rents up to NIS 20,000 the Fair Rental Law applies, and guarantees are capped at the lower of 3 months' rent or a third of the total rent: up to NIS 28,500 on a lease of 9 months or more."
     }
    },
    {
     "@type": "Question",
     "name": "Is there construction nearby?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. A 30-floor tower on Einstein Street is due for completion in mid-2028, and the Sde Dov district is being built west of the neighborhood."
     }
    }
   ]
