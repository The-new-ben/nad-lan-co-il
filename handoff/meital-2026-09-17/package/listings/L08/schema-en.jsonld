  {
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What is the price per sqm in the complex?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The asking price is about NIS 45,385 per sqm. Appraisers valued typical units in the complex at NIS 45,000 to 50,000 per sqm in 2024, and two 2026 sales of 130 sqm units on the street were recorded at NIS 43,846 and 54,615 per sqm."
     }
    },
    {
     "@type": "Question",
     "name": "How much is the complex fee?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Globes reported about NIS 2,300 a month for a 138 sqm apartment in 2024, including maintenance and use of all facilities. For 130 sqm that is about NIS 2,170 a month if the fee scales with area; ask for the current amount."
     }
    },
    {
     "@type": "Question",
     "name": "How far is the sea?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "About two minutes on foot to the sea and Tzuk beach. A rental listing by another advertiser in the complex says five minutes."
     }
    },
    {
     "@type": "Question",
     "name": "How much purchase tax would a buyer pay?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Under the 2026 brackets: about NIS 190,538 for a single-home buyer, NIS 472,000 for an additional home or a foreign resident, and about NIS 19,606 for an eligible new immigrant."
     }
    },
    {
     "@type": "Question",
     "name": "What will change around the complex?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The Ibn Gabirol extension has been paved to the east, with the Green Line planned along it; a design plan for a hotel and residential tower was approved at Tzuk beach; and the open land around the complex is part of plan TA/3700."
     }
    }
   ]
  }
 ]
