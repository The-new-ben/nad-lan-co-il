   "mainEntity": [
    {
     "@type": "Question",
     "name": "מה המחיר למ״ר במתחם?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "המחיר המבוקש הוא כ-45,385 ש״ח למ״ר. שמאים העריכו ב-2024 דירות טיפוסיות במתחם ב-45,000 עד 50,000 ש״ח למ״ר, ושתי עסקאות של דירות 130 מ״ר ברחוב נרשמו ב-2026 ב-43,846 וב-54,615 ש״ח למ״ר."
     }
    },
    {
     "@type": "Question",
     "name": "כמה עולים דמי הניהול?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "גלובס דיווח ב-2024 על כ-2,300 ש״ח לחודש לדירה של 138 מ״ר, כולל תחזוקה ושימוש בכל המתקנים. לדירה של 130 מ״ר זה כ-2,170 ש״ח לחודש בהנחה שהתעריף יחסי לשטח; יש לקבל את הסכום העדכני."
     }
    },
    {
     "@type": "Question",
     "name": "כמה רחוק הים?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "לפי המשווקת כשתי דקות הליכה לים ולחוף הצוק. מודעת שכירות של מפרסם אחר במתחם מציינת חמש דקות הליכה."
     }
    },
    {
     "@type": "Question",
     "name": "כמה מס רכישה ישלם רוכש?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "לפי מדרגות 2026: כ-190,538 ש״ח לרוכש דירה יחידה, 472,000 ש״ח לדירה נוספת או לתושב חוץ, וכ-19,606 ש״ח לעולה חדש זכאי."
     }
    },
    {
     "@type": "Question",
     "name": "מה ישתנה סביב המתחם?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "ממזרח נסלל המשך אבן גבירול, שלאורכו מתוכנן הקו הירוק; בחוף הצוק אושרה תכנית עיצוב למלון ולמגדל מגורים; והשטחים הפנויים סביב המתחם כלולים בתכנית תא/3700."
     }
    }
   ]
