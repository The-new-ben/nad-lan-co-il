   "mainEntity": [
    {
     "@type": "Question",
     "name": "What yield does the apartment produce?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "At the NIS 15,000 monthly rent the broker reported, the gross yield is 3.60% on NIS 5,000,000. If the landlord pays the management fee it is 3.46%, and under the 10% rental tax track 3.24%."
     }
    },
    {
     "@type": "Question",
     "name": "Can the buyer take the unit vacant?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "In November 2025 the broker noted flexible vacating. Obtain the lease end date and the tenant's position in writing before making an offer."
     }
    },
    {
     "@type": "Question",
     "name": "What does the furniture include?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "According to the broker it is furnished and equipped, including kitchenware and towels. Attach an inventory to the contract and ask a lawyer how the furniture is treated in the tax filing."
     }
    },
    {
     "@type": "Question",
     "name": "How much purchase tax would an investor pay?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A buyer of an additional home or a foreign resident would pay about NIS 400,000 (8%). A single-home buyer would pay about NIS 145,538, and an eligible new immigrant about NIS 15,106."
     }
    },
    {
     "@type": "Question",
     "name": "How does it differ from the 3-room unit in the same building?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The same building also offers an unfurnished 3-room unit at NIS 4,650,000. The NIS 350,000 gap reflects furniture, a sitting tenant and an extra half room as the broker describes it."
