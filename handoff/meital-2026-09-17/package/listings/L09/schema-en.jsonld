    {
     "@type": "Question",
     "name": "What does the apartment cost per month?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The rent is given on direct request. Based on similar listings in Nofei Yam and Lamed HaHadasha, the market range for 135 sqm is about NIS 15,500 to 20,250 a month, before arnona and the building fee. This is a computation, not a quote."
     }
    },
    {
     "@type": "Question",
     "name": "When can a tenant move in?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Entry is flexible, and the date is agreed directly with Meital Katzir."
     }
    },
    {
     "@type": "Question",
     "name": "What does the building offer?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The building has a gym and a guard. The hours of the guard and what the building fee covers are given on request."
     }
    },
    {
     "@type": "Question",
     "name": "Does the Fair Rental Law apply?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Only if the rent does not exceed about NIS 20,000 a month. Then guarantees are capped at 3 months' rent at most, and the landlord's repair duties apply. The computed range for this unit crosses that threshold."
     }
    },
    {
     "@type": "Question",
     "name": "Is the parking EV-ready?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The parking spaces are prepared for charging. The installation and electricity details are given on request."
     }
    }
