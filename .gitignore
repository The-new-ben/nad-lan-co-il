# Build artifacts — generated, not source. The canonical plugin source is plugins/nadlan-config/.
nadlan-config.zip
plugin-build/

# auto-update dist (committed on purpose)
!plugin-dist/
plugin-dist/*
!plugin-dist/nadlan-config.json
!plugin-dist/*.zip

# Local SEO/visual audit cache
.seo-cache/

# Installed JS deps — package.json/package-lock.json are the source of truth
node_modules/

# Private unit-journey acceptance output stays outside the public repository.
# It may contain the protected URL and unlocked screenshots (never the password).
reports/private-unit-journey-release/
reports/local-v2-*.png
docs/qa/private-unit-journey/
scripts/__pycache__/

# Credentials & local secrets — NEVER commit
.env.local
.env
wp-api.ps1

# Codex desktop local runtime state. This may contain auth, browser sessions,
# logs, SQLite state, generated caches, and private conversation artifacts.
.codex/
