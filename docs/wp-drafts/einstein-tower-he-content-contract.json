  "faq": [
    {
      "q": "האם איינשטיין 18 היא הכתובת הרשמית של הפרויקט?",
      "a": "הפרויקט מזוהה בדוח החברה כאיינשטיין 33א׳ בגוש 6885 חלקה 32. בשכבת הכתובות העירונית איינשטיין 18 נמצאת על חלקה 40 הסמוכה. עד למסמך התאמה רשמי משתמשים ב-EINSTEIN TOWER, איינשטיין 33א׳ ופינת איינשטיין ולוי אשכול.",
      "source_ids": ["S002", "S006", "S007"]
    },
    {
      "q": "כמה מבנים וכמה יחידות דיור מתוכננים?",
      "a": "הדוח השנתי מתאר 215 יחידות דיור בשלושה מבנים: מגדל בן 28 קומות ושני מבני מגורים בני 13 קומות מעל בסיס מסחרי כפול.",
      "source_ids": ["S002"]
    },
    {
      "q": "מה מצב הבנייה וההיתר?",
      "a": "רשומת העירייה מציגה היתר 20241734 מתאריך 9 ביולי 2026, ובו בזמן שדה השלב הגולמי שלה הוא בתהליך היתר. היתר הכנה נפרד, 20240229 מ-25 במרץ 2024, כולל דיפון, חפירה, ביסוס ורצפה ראשונה. לפי דוח החברה, חפירה ודיפון כבר בוצעו עד 31 בדצמבר 2025; לא נגזר מכך קצב הביצוע כיום.",
      "source_ids": ["IVS008", "IVS009", "S002"]
    },
    {
      "q": "מתי החברה מעריכה שהפרויקט יושלם?",
      "a": "בדוח השנתי מופיעה הערכה לרבעון השלישי של 2030. מועד הרכישה הקובע הוא המועד והתרופות שנכתבים בהסכם הספציפי.",
      "source_ids": ["S002"]
    },
    {
      "q": "האם הקו הירוק פועל ליד הפרויקט?",
      "a": "לא. איינשטיין ולוי אשכול מופיעות כתחנות עתידיות של הקו הירוק, ובצומת מתקיימות עבודות תשתית. המקור שנבדק אינו קובע מועד הפעלה מחייב למקטע הצפוני.",
      "source_ids": ["S009", "S010"]
    },
    {
      "q": "מה המרחק מהים?",
      "a": "המדידה שנערכה היא כ-975 מטרים בקו ישר מנקודת איינשטיין 16א׳ אל הפוליגון העירוני של חוף תל ברוך. מסלול הליכה וזמן הגעה נבדקים בנפרד.",
      "source_ids": ["S017"]
    },
    {
      "q": "איזה בית ספר משויך כיום לנקודה שנבדקה?",
      "a": "בשכבת 2026/27 התקבל אזור נופי ים לנקודת איינשטיין 16א׳. השיוך בעת האכלוס ייקבע לפי הכתובת הרשומה והכללים שיהיו באותה שנת לימודים.",
      "source_ids": ["S013", "S014", "S015"]
    },
    {
      "q": "האם אפשר לבחור דירה מתוך המודל?",
      "a": "אפשר לחקור את המבנים, הכיוונים וחוויית הבדיקה. בחירה מסחרית של דירה תיפתח כאשר תתקבל שורת מלאי מזוהה ומתוארכת הכוללת בניין, קומה, שטח, כיוון, מחיר ומצב.",
      "source_ids": ["DR-006"]
    },
    {
      "q": "האם מופיע מחיר עדכני?",
      "a": "לא מוצג מחיר כללי. מחיר יוצג רק כהצעה מתוארכת לזכות מסוימת, עם פירוט מה כלול, הצמדה, עלויות נוספות ומועד תוקף.",
      "source_ids": ["S001", "S002", "DR-006"]
    }
  ],
