[
 {
  "label": "One national average asking price per m²",
  "re": [
   "(ממוצע|הממוצע|average)[^.]{0,60}€\\s?\\d,\\d{3}[^.]{0,25}(למ״ר|למ\"ר|למטר|/m|per m)",
   "€\\s?\\d,\\d{3}[^.]{0,25}(למ״ר|למ\"ר|למטר)[^.]{0,40}(ממוצע|בממוצע)"
  ]
 },
 {
  "label": "The month or quarter of the national number",
