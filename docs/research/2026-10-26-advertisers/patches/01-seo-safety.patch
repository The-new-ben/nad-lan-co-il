+		<?php elseif ( '' !== $wa ) : ?><a class="nlds-btn nlds-btn--primary" target="_blank" rel="<?php echo esc_attr( $rel ); ?>" href="https://wa.me/<?php echo esc_attr( $wa ); ?>?text=<?php echo rawurlencode( (string) $args['wa_text'] ); ?>"<?php echo $args['link_attrs']; // phpcs:ignore ?>><?php echo nlds_icon( 'whatsapp' ); // phpcs:ignore ?><span><?php echo esc_html( $args['wa_label'] ); ?></span></a><?php endif; ?>
 		<a class="nlds-btn nlds-btn--secondary" href="<?php echo esc_url( $href ); ?>"<?php echo $args['link_attrs']; // phpcs:ignore ?>><span><?php echo esc_html( $args['site_label'] ); ?></span><?php echo nlds_icon( 'forward' ); // phpcs:ignore ?></a>
