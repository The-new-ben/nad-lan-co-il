/* The example apartment from the inside (design system ApartmentTour): a full-screen 360° viewer.
   Loaded only when the buyer asks for it (the card's button in the page). A sphere carries the panorama; the small
   picture shows first, the large one replaces it. Drag or arrow keys look around, the wheel or a pinch zooms, Esc closes.
   openTour({ scenes: [{ id, dir, dirLabel, spot, spotLabel, title, src, small, note }], start, chip, caption, hint, close,
   opener }) (or a single { src, srcSmall, title }). Two switches at the bottom: the directions (version 25) and, above them,
   where one stands (version 26: in the living room, on the balcony); each keeps the other. Every picture opens facing out.
   The shared viewing room (inc/together.php, design system TogetherRoom v77) reads and sets the look from outside: the
   returned handle has getView() / setView(v, dur) ({ scene, yaw, pitch, fov }, radians and degrees of field), project()
   and pick() (a direction on the screen and back); while it is open it is window.__nlTour, it sends nl:tour on opening and
   closing, and nl:view (throttled) while the visitor looks around himself. */
import * as THREE from 'three';

let cssDone = false;
function ensureCss() {
  if (cssDone || document.querySelector('link[data-nlat-css]')) { cssDone = true; return; }
  const l = document.createElement('link');
  l.rel = 'stylesheet';
  l.href = new URL('./tour.css' + new URL(import.meta.url).search, import.meta.url).href;
  l.setAttribute('data-nlat-css', '');
  document.head.appendChild(l);
  cssDone = true;
}

export function openTour(o) {
  ensureCss();
  if (window.__nlTour && typeof window.__nlTour.close === 'function') window.__nlTour.close(); // never two viewers (Codex 28.9)
  const scenes = (Array.isArray(o.scenes) && o.scenes.length ? o.scenes
    : [{ id: 'one', label: '', title: o.title || '', src: o.src, small: o.srcSmall, note: '' }])
    .map((sc) => ({ ...sc, dir: sc.dir || sc.id, dirLabel: sc.dirLabel || sc.label || '', spot: sc.spot || 'living', spotLabel: sc.spotLabel || '',
      group: sc.group || 'apt' }));
  /* BuildingWalk v96: one viewer for the whole building. Apartment scenes ('apt', one floor or several, each with its floor)
     keep the direction and place switches; the building's rooms ('fac': the lobby, the club, the roof pool) hide them. A
     scene's doors ({ to, yaw, pitch, label, sub, kind }, degrees from the picture's centre, + = right / up, as the render
     scripts' LOCATE prints them) are buttons standing in the picture; 'lift' opens the lift's panel (o.lift.stops). */
  const apt = scenes.filter((sc) => sc.group === 'apt');
  const uniq = (key, label) => { const seen = new Map(); for (const sc of apt) if (!seen.has(sc[key])) seen.set(sc[key], sc[label]); return [...seen]; };
  const dirs = uniq('dir', 'dirLabel'), spots = uniq('spot', 'spotLabel');
  let lastFloor = null, lastDir = null; // the apartment one came from, for the lift and the switches
  const pick = (dir, spot, floor) => {
    const fl = floor != null ? floor : (cur && cur.group === 'apt' ? cur.floor : lastFloor);
    const pool = apt.length ? apt : scenes;
    const same = (sc) => fl == null || sc.floor == null || Number(sc.floor) === Number(fl);
    return pool.find((sc) => sc.dir === dir && sc.spot === spot && same(sc)) || pool.find((sc) => sc.dir === dir && same(sc))
      || pool.find((sc) => sc.spot === spot && same(sc)) || pool.find((sc) => sc.dir === dir && sc.spot === spot) || pool.find((sc) => sc.dir === dir) || scenes[0];
  };
  let cur = scenes.find((sc) => sc.id === o.start) || scenes.find((sc) => sc.dir === o.start && sc.spot === 'living') || scenes[0];
  const prevFocus = o.opener || document.activeElement; // back to the button that opened it (Safari does not focus a clicked button)
  const root = document.createElement('div');
  root.className = 'nlds nlat-viewer';
  root.dir = 'rtl';
  root.lang = 'he';
  root.setAttribute('role', 'dialog');
  root.setAttribute('aria-modal', 'true');
  root.setAttribute('aria-label', cur.title || '');
  const top = document.createElement('div');
  top.className = 'nlat-viewer__top';
  const title = document.createElement('p');
  title.className = 'nlat-viewer__title';
  title.textContent = cur.title || '';
  const chip = document.createElement('span');
  chip.className = 'nlds-sample';
  chip.textContent = cur.chip || o.chip || 'דירה לדוגמה';
  const x = document.createElement('button');
  x.type = 'button';
  x.className = 'nlat-viewer__x';
  x.setAttribute('aria-label', o.close || 'סגירה');
  x.textContent = '×';
  top.append(title, chip, x);
  const hint = document.createElement('p');
  hint.className = 'nlat-viewer__hint';
  hint.textContent = o.hint || 'גררו כדי להסתכל מסביב';
  const cap = document.createElement('p');
  cap.className = 'nlat-viewer__cap';
  // design styles (design system ApartmentStyles v80): 'bare' is the room as delivered, the scene's own picture
  let style = 'bare';
  const styleOf = (sc) => (style !== 'bare' && Array.isArray(sc.styles) ? sc.styles.find((st) => st.id === style) : null) || null;
  const setCaption = () => { cap.textContent = [cur.caption != null ? cur.caption : (o.caption || ''), styleOf(cur) ? (o.styleNote || 'רעיון עיצוב להמחשה, לא המפרט של היזם.') : '', cur.note || ''].filter(Boolean).join(' '); };
  setCaption();
  const stage = document.createElement('div');
  stage.className = 'nlat-viewer__stage';
  // the bottom column: where one stands, the directions, the caption (stacked, so a long caption never covers a switch)
  const bottom = document.createElement('div');
  bottom.className = 'nlat-viewer__bottom';
  // BuildingWalk v96: the doors stand in the picture (a layer over the stage), the building's places run under the title
  const doorsBox = document.createElement('div');
  doorsBox.className = 'nlat-viewer__doors';
  const places = Array.isArray(o.places) && o.places.length > 1 ? o.places : null;
  const placesBar = document.createElement('div');
  placesBar.className = 'nlat-viewer__places';
  placesBar.setAttribute('role', 'group');
  placesBar.setAttribute('aria-label', o.placesLabel || 'בבניין');
  placesBar.hidden = !places;
  root.append(stage, doorsBox, top, placesBar, hint, bottom);
  // the two switches: the directions, and where one stands; one pressed in each, each keeps the other
  const ctrls = [];
  function makeBar(cls, label, items, onPick) {
    const bar = document.createElement('div');
    bar.className = cls;
    bar.setAttribute('role', 'group');
    bar.setAttribute('aria-label', label);
    const btns = new Map();
    for (const [id, text] of items) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = text;
      b.addEventListener('click', () => onPick(id));
      btns.set(id, b);
      bar.appendChild(b);
      ctrls.push(b);
    }
    bottom.appendChild(bar);
    return btns;
  }
  const spotBtns = spots.length > 1 ? makeBar('nlat-viewer__spots', o.spotLabel || 'איפה עומדים', spots, (id) => show(pick(cur.dir, id))) : null;
  const dirBtns = dirs.length > 1 ? makeBar('nlat-viewer__dirs', o.barLabel || 'כיוון הדירה', dirs, (id) => show(pick(id, cur.spot))) : null;
  bottom.appendChild(cap);
  /* the design styles panel: at the inline end on wide screens, a strip over the switches on phones; only where the scene
     has styles (today floor 25, the living room, toward the sea) */
  const stylesBox = document.createElement('div');
  stylesBox.className = 'nlat-viewer__styles';
  stylesBox.setAttribute('role', 'group');
  stylesBox.setAttribute('aria-label', o.stylesLabel || 'עיצוב הדירה');
  stylesBox.hidden = true;
  const stylesHead = document.createElement('p');
  stylesHead.className = 'nlat-viewer__styles-h';
  const stylesHeadB = document.createElement('span');
  stylesHeadB.textContent = o.stylesLabel || 'עיצוב הדירה';
  const stylesHeadS = document.createElement('small');
  stylesHeadS.textContent = o.stylesSub || 'רעיון להמחשה';
  stylesHead.append(stylesHeadB, stylesHeadS);
  const styleBtns = new Map();
  function buildStyles() {
    const list = Array.isArray(cur.styles) ? cur.styles : [];
    styleBtns.clear();
    stylesBox.replaceChildren(stylesHead);
    for (const st of list) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'nlat-style';
      if (st.thumb) { const im = document.createElement('img'); im.src = st.thumb; im.alt = ''; im.loading = 'lazy'; im.width = 64; im.height = 40; b.appendChild(im); }
      const tx = document.createElement('span');
      const nm = document.createElement('b'); nm.textContent = st.label || st.id;
      const sub = document.createElement('small'); sub.textContent = st.sub || '';
      tx.append(nm, sub);
      b.appendChild(tx);
      b.addEventListener('click', () => applyStyle(st.id));
      styleBtns.set(st.id, b);
      stylesBox.appendChild(b);
      ctrls.push(b);
    }
    stylesBox.hidden = list.length < 2;
    markStyles();
  }
  function markStyles() { for (const [id, b] of styleBtns) b.setAttribute('aria-pressed', id === style ? 'true' : 'false'); }
  const phoneMq = window.matchMedia ? window.matchMedia('(max-width: 900px)') : null;
  const placeStyles = () => { if (phoneMq && phoneMq.matches) bottom.insertBefore(stylesBox, bottom.firstChild); else root.appendChild(stylesBox); };
  if (phoneMq && phoneMq.addEventListener) phoneMq.addEventListener('change', placeStyles);
  if (dirBtns) root.classList.add('has-dirs');
  if (spotBtns) root.classList.add('has-spots');
  function markBars() {
    const inApt = cur.group === 'apt';
    root.classList.toggle('is-fac', !inApt); // the building's rooms: no direction or place switch
    if (inApt) { lastFloor = cur.floor != null ? cur.floor : lastFloor; lastDir = cur.dir; }
    if (dirBtns) for (const [id, b] of dirBtns) b.setAttribute('aria-pressed', inApt && id === cur.dir ? 'true' : 'false');
    if (spotBtns) for (const [id, b] of spotBtns) {
      b.setAttribute('aria-pressed', inApt && id === cur.spot ? 'true' : 'false');
      // a place this direction (on this floor) has not rendered
      b.disabled = !apt.some((sc) => sc.dir === cur.dir && sc.spot === id && (cur.floor == null || sc.floor == null || Number(sc.floor) === Number(cur.floor)));
    }
    markPlaces();
  }
  /* the building's places under the title: the lobby, the club, the roof pool, the apartment (its floor) */
  const placeBtns = [];
  const placeOf = (p) => (p.to ? scenes.find((sc) => sc.id === p.to) : null);
  function markPlaces() {
    for (const { p, b } of placeBtns) {
      const here = p.apt ? cur.group === 'apt' : cur.id === p.to;
      b.setAttribute('aria-current', here ? 'location' : 'false');
      if (p.apt) b.textContent = (p.label || 'הדירה') + (cur.group === 'apt' && cur.floor != null ? ' · קומה ' + cur.floor : (lastFloor != null ? ' · קומה ' + lastFloor : ''));
      // on a phone the row scrolls: the place one stands in comes into view
      if (here && placesBar.scrollWidth > placesBar.clientWidth + 1) {
        const r = b.getBoundingClientRect(), pr = placesBar.getBoundingClientRect();
        if (r.left < pr.left || r.right > pr.right) placesBar.scrollLeft += (r.left + r.width / 2) - (pr.left + pr.width / 2);
      }
    }
  }
  if (places) {
    const lead = document.createElement('span');
    lead.className = 'nlat-viewer__places-h';
    lead.textContent = o.placesLabel || 'בבניין';
    placesBar.appendChild(lead);
    for (const p of places) {
      if (!p.apt && !placeOf(p)) continue;
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = p.label || '';
      b.addEventListener('click', () => {
        if (p.apt) { if (cur.group !== 'apt') walkTo(pick(lastDir || p.dir || 'w', 'living', lastFloor != null ? lastFloor : p.floor).id); }
        else walkTo(p.to);
      });
      placeBtns.push({ p, b });
      placesBar.appendChild(b);
    }
  }
  markBars();
  placeStyles();
  buildStyles();
  document.body.appendChild(root);
  document.documentElement.classList.add('nlat-open');
  const placesRo = places && window.ResizeObserver ? new ResizeObserver(() => markPlaces()) : null; // measured once its style has loaded
  if (placesRo) placesRo.observe(placesBar);

  const renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  stage.appendChild(renderer.domElement);
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(72, 1, 0.1, 1200);
  const geo = new THREE.SphereGeometry(500, 96, 48);
  geo.scale(-1, 1, 1); // seen from inside
  const mat = new THREE.MeshBasicMaterial({ color: 0xffffff });
  scene.add(new THREE.Mesh(geo, mat));

  // yaw 0 looks at the panorama's centre (the window); the sphere's u = 0.5 lies on -x
  let yaw = 0, pitch = -0.05, fov = 72, vy = 0, vp = 0, raf = 0, alive = true, moved = false, dragging = false;
  const look = new THREE.Vector3();
  // the shared viewing room: a glide to a look set from outside, and a throttled nl:view while the visitor looks around
  let tween = null, viewAt = 0, viewT = 0;
  const reducedMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  const getView = () => ({ mode: 'inside', scene: cur.id, dir: cur.dir, spot: cur.spot, floor: cur.floor != null ? Number(cur.floor) : null, style,
    yaw: +yaw.toFixed(4), pitch: +Math.max(-1.45, Math.min(1.45, pitch)).toFixed(4), fov: +fov.toFixed(2) });
  function sendView() { viewT = 0; if (!alive) return; viewAt = performance.now(); window.dispatchEvent(new CustomEvent('nl:view', { detail: Object.assign(getView(), { source: 'user' }) })); }
  function userView() { const w = 100 - (performance.now() - viewAt); if (w <= 0) sendView(); else if (!viewT) viewT = setTimeout(sendView, w); }
  function render() {
    raf = 0;
    if (!alive) return;
    if (tween) { // a look set from outside (setView), eased
      const t = Math.min(1, (performance.now() - tween.t0) / tween.ms), e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      yaw = tween.y0 + tween.dy * e; pitch = tween.p0 + (tween.p1 - tween.p0) * e; fov = tween.f0 + (tween.f1 - tween.f0) * e;
      if (t < 1) raf = requestAnimationFrame(render); else tween = null;
    }
    if (!dragging && (Math.abs(vy) > 1e-4 || Math.abs(vp) > 1e-4)) { // a little glide after the finger lifts
      yaw += vy; pitch += vp; vy *= 0.86; vp *= 0.86;
      if (!raf) raf = requestAnimationFrame(render);
    }
    pitch = Math.max(-1.45, Math.min(1.45, pitch));
    camera.fov = fov;
    camera.updateProjectionMatrix();
    look.set(-Math.cos(yaw) * Math.cos(pitch), Math.sin(pitch), Math.sin(yaw) * Math.cos(pitch));
    camera.lookAt(look);
    renderer.render(scene, camera);
    placeDoors();
  }
  const kick = () => { if (!raf) raf = requestAnimationFrame(render); };
  function size() {
    const w = stage.clientWidth || window.innerWidth, h = stage.clientHeight || window.innerHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    kick();
  }
  const ro = new ResizeObserver(size);
  ro.observe(stage);
  size();

  const loader = new THREE.TextureLoader();
  const load = (url) => new Promise((res, rej) => loader.load(url, res, undefined, rej));
  const useTex = (t) => {
    t.colorSpace = THREE.SRGBColorSpace;
    t.anisotropy = Math.min(8, renderer.capabilities.getMaxAnisotropy());
    const old = mat.map;
    mat.map = t;
    mat.needsUpdate = true;
    if (old) old.dispose();
    root.classList.add('is-ready');
    root.classList.remove('is-swapping', 'is-walking');
    kick();
  };
  let loadId = 0;
  let pre = null; // BuildingWalk v96: the next room's small picture, loaded before the move
  function loadScene(sc) {
    const id = ++loadId;
    const fresh = () => alive && id === loadId; // a later switch wins over a slower picture
    root.classList.remove('is-error');
    const st = styleOf(sc), small = st ? (st.small || st.src) : sc.small, full = st ? st.src : sc.src;
    const first = small || full;
    let ready = null;
    if (pre && pre.id === sc.id && pre.url === first) ready = Promise.resolve(pre.t);
    else if (pre) pre.t.dispose();
    pre = null;
    // a small picture that fails still tries the large one (Codex consult 28.9)
    (ready || load(first).catch(() => (full && full !== first ? load(full).then((t) => { t.userData.full = true; return t; }) : Promise.reject(new Error('tour')))))
      .then((t) => {
        if (!fresh()) { t.dispose(); return null; }
        useTex(t);
        return !t.userData.full && small && full && full !== small ? load(full) : null;
      }).then((t) => { if (t) { if (fresh()) useTex(t); else t.dispose(); } }).catch(() => { if (fresh()) root.classList.add('is-error'); });
  }
  function show(sc, src) {
    if (sc === cur) return;
    cur = sc;
    if (style !== 'bare' && !styleOf(sc)) style = 'bare'; // a scene without this style shows the room as delivered
    buildStyles();
    title.textContent = sc.title || '';
    chip.textContent = sc.chip || o.chip || 'דירה לדוגמה';
    root.setAttribute('aria-label', sc.title || '');
    live.textContent = sc.title || '';
    setCaption();
    markBars();
    buildDoors();
    closeLift();
    yaw = 0; pitch = -0.05; vy = vp = 0;   // facing its own window
    if (src === 'walk') fov = 72;
    tween = null;
    loadScene(sc);
    if (src !== 'api') { if (typeof o.onScene === 'function') o.onScene(sc.id); userView(); }
    kick();
  }
  loadScene(cur);

  /* ---- BuildingWalk v96: the doors, the lift's destinations and the crossfade ----
     Every connection here is illustrative (Codex consult 28.9: a published facility does not prove a doorway): the doors
     are jumps between illustrations, the move is a short crossfade once the next picture has loaded, never an animated
     lift ride or an unseen corridor. A door: { to, at: [yaw, pitch] (degrees from the picture's centre, + = right / up,
     as the render scripts' LOCATE prints them), label, sub, arrival: { yaw, pitch } (degrees, optional) }. */
  const RAD = Math.PI / 180;
  const dv = new THREE.Vector3();
  let doorEls = [];
  const history = [];
  function buildDoors() {
    doorsBox.replaceChildren();
    doorEls = [];
    for (const d of (Array.isArray(cur.doors) ? cur.doors : [])) {
      const target = d.to === 'lift' ? (lift ? 'lift' : null) : scenes.find((sc) => sc.id === d.to);
      if (!target || !Array.isArray(d.at)) continue; // a door to a room this viewer does not have is not drawn
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'nlat-door';
      b.dataset.kind = d.to === 'lift' ? 'lift' : 'jump';
      const ring = document.createElement('i');
      ring.setAttribute('aria-hidden', 'true');
      const tx = document.createElement('span');
      const nm = document.createElement('b'); nm.textContent = d.label || '';
      tx.appendChild(nm);
      if (d.sub) { const sm = document.createElement('small'); sm.textContent = d.sub; tx.appendChild(sm); }
      b.append(ring, tx);
      b.addEventListener('click', () => (d.to === 'lift' ? openLift(b) : walkTo(d.to, d.arrival)));
      // a keyboard visitor who tabs to a door is turned towards it
      b.addEventListener('focus', () => { if (b.matches(':focus-visible')) setView({ yaw: -Number(d.at[0]) * RAD, pitch: Number(d.at[1]) * RAD }, 0.5); });
      doorsBox.appendChild(b);
      doorEls.push({ el: b, y: -Number(d.at[0] || 0) * RAD, p: Number(d.at[1] || 0) * RAD });
    }
    root.classList.toggle('has-doors', doorEls.length > 0);
    placeDoors();
  }
  function placeDoors() { // every rendered frame: drags, glides and looks set from outside
    if (!doorEls.length) return;
    const w = stage.clientWidth || window.innerWidth, h = stage.clientHeight || window.innerHeight;
    for (const d of doorEls) {
      dv.set(-Math.cos(d.y) * Math.cos(d.p), Math.sin(d.p), Math.sin(d.y) * Math.cos(d.p)).multiplyScalar(100).project(camera);
      const on = dv.z < 1 && Math.abs(dv.x) < 0.94 && Math.abs(dv.y) < 0.86;
      d.el.classList.toggle('is-off', !on);
      if (on) d.el.style.transform = 'translate(' + ((dv.x * 0.5 + 0.5) * w).toFixed(1) + 'px,' + ((-dv.y * 0.5 + 0.5) * h).toFixed(1) + 'px)';
    }
  }
  /* the move: the room fades, the next picture loads, then it shows (title, doors and picture together) and fades in */
  let walking = false;
  function walkTo(id, arrival, back) {
    const sc = scenes.find((x2) => x2.id === id);
    if (!alive || walking || !sc || sc === cur) return false;
    walking = true;
    closeLift();
    const from = cur;
    root.classList.add('is-walking');
    const url = sc.small || sc.src;
    const pause = new Promise((r) => setTimeout(r, reducedMotion ? 0 : 160));
    Promise.all([load(url).catch(() => null), pause]).then(([t]) => {
      walking = false;
      if (!alive) { if (t) t.dispose(); return; }
      pre = t ? { id: sc.id, url, t } : null;
      if (!back) history.push(from.id);
      show(sc, 'walk');
      if (arrival && Number.isFinite(Number(arrival.yaw))) { yaw = -Number(arrival.yaw) * RAD; pitch = Number(arrival.pitch || 0) * RAD; kick(); }
      markBack();
    });
    return true;
  }
  /* the lift's destinations: a list anchored at the lift doors of the picture (the lobby, the club's floor, the apartments'
     floors this viewer has); choosing one is the same crossfade */
  const lift = o.lift && Array.isArray(o.lift.stops) && o.lift.stops.length ? o.lift : null;
  const liftBox = document.createElement('div');
  liftBox.className = 'nlat-lift';
  liftBox.setAttribute('role', 'group');
  liftBox.hidden = true;
  const live = document.createElement('p'); // the room's name, said when it changes
  live.className = 'nlat-viewer__live';
  live.setAttribute('aria-live', 'polite');
  root.append(liftBox, live);
  const stopScene = (s) => (s.to ? scenes.find((sc) => sc.id === s.to) : pick(lastDir || s.dir || 'w', 'living', s.floor));
  let liftBtns = [], liftOpener = null;
  function openLift(opener) {
    if (!lift || !alive) return;
    liftOpener = opener || null;
    liftBox.replaceChildren();
    liftBtns = [];
    liftBox.setAttribute('aria-label', lift.title || 'לאן?');
    const head = document.createElement('p');
    head.className = 'nlat-lift__h';
    const hb = document.createElement('b'); hb.textContent = lift.title || 'לאן?';
    const hs = document.createElement('small'); hs.textContent = lift.note || 'מעבר להמחשה';
    head.append(hb, hs);
    const xx = document.createElement('button');
    xx.type = 'button';
    xx.className = 'nlat-lift__x';
    xx.setAttribute('aria-label', o.liftClose || 'סגירה');
    xx.textContent = '×';
    xx.addEventListener('click', () => closeLift(true));
    liftBox.append(head, xx);
    for (const s of lift.stops) {
      const sc = stopScene(s);
      if (!sc || (s.floor != null && Number(sc.floor) !== Number(s.floor))) continue; // a floor this viewer has no picture of
      const here = s.floor != null ? cur.group === 'apt' && Number(cur.floor) === Number(s.floor) : cur.id === sc.id;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'nlat-lift__stop';
      const n = document.createElement('b'); n.textContent = s.label || '';
      b.appendChild(n);
      if (s.sub) { const sm = document.createElement('small'); sm.textContent = s.sub; b.appendChild(sm); }
      if (here) { // "you are here" is text, not a style's content, so a language page can translate it
        b.disabled = true; b.setAttribute('aria-current', 'location');
        const hh = document.createElement('i'); hh.className = 'nlat-lift__here'; hh.textContent = o.hereLabel || 'אתם כאן';
        n.append(' · ', hh);
      }
      b.addEventListener('click', () => { const t2 = stopScene(s); if (t2) walkTo(t2.id); });
      liftBox.appendChild(b);
      liftBtns.push(b);
    }
    liftBtns.push(xx);
    liftBox.hidden = false;
    root.classList.add('is-lift');
    const first = liftBtns.find((b) => !b.disabled);
    if (first) first.focus();
  }
  function closeLift(back) {
    if (liftBox.hidden) return;
    liftBox.hidden = true;
    root.classList.remove('is-lift');
    liftBtns = [];
    if (back && liftOpener && liftOpener.isConnected) liftOpener.focus();
  }
  /* back: the room one came from (the walk's own history, not the browser's) */
  let backBtn = null;
  if (places) {
    backBtn = document.createElement('button');
    backBtn.type = 'button';
    backBtn.className = 'nlat-viewer__back';
    backBtn.textContent = o.backLabel || 'חזרה';
    backBtn.hidden = true;
    backBtn.addEventListener('click', () => { const id = history.pop(); if (id) walkTo(id, null, true); markBack(); });
    placesBar.insertBefore(backBtn, placesBar.firstChild);
    if (o.routeNote) { const rn = document.createElement('small'); rn.className = 'nlat-viewer__places-note'; rn.textContent = o.routeNote; placesBar.appendChild(rn); }
  }
  function markBack() { if (backBtn) backBtn.hidden = history.length === 0; }
  buildDoors();
  /* a style: the same room and the same look, another picture (a short dim while it loads) */
  function applyStyle(id, src) {
    if (!alive || id === style) return false;
    if (id !== 'bare' && !(Array.isArray(cur.styles) && cur.styles.some((st) => st.id === id))) return false;
    style = id;
    markStyles();
    setCaption();
    root.classList.add('is-swapping');
    loadScene(cur);
    if (src !== 'api') { if (typeof o.onStyle === 'function') o.onStyle(id); userView(); }
    return true;
  }

  // looking around: drag (one pointer), pinch (two), the wheel, the arrow keys
  const pts = new Map();
  let last = null, pinch0 = 0, fov0 = fov;
  // the point under the finger stays under the finger: the vertical field of view over the stage's height
  const k = () => (fov * Math.PI / 180) / Math.max(200, stage.clientHeight || window.innerHeight);
  function onDown(e) {
    pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    stage.setPointerCapture(e.pointerId);
    vy = vp = 0;
    tween = null;
    dragging = true;
    if (pts.size === 1) last = { x: e.clientX, y: e.clientY };
    if (pts.size === 2) { const [a, b] = [...pts.values()]; pinch0 = Math.hypot(a.x - b.x, a.y - b.y); fov0 = fov; }
  }
  function onMove(e) {
    if (!pts.has(e.pointerId)) return;
    pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pts.size === 2) {
      const [a, b] = [...pts.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch0 > 0) fov = Math.max(35, Math.min(90, fov0 * (pinch0 / d)));
      kick();
      userView();
      return;
    }
    if (!last) return;
    const dx = e.clientX - last.x, dy = e.clientY - last.y;
    last = { x: e.clientX, y: e.clientY };
    // dragging the picture to the left turns the view to the right (the room follows the finger)
    vy = dx * k(); vp = dy * k();
    yaw += vy; pitch += vp;
    if (!moved && Math.hypot(dx, dy) > 2) { moved = true; root.classList.add('is-moved'); }
    kick();
    userView();
  }
  function onUp(e) {
    pts.delete(e.pointerId);
    if (pts.size < 2) pinch0 = 0;
    if (pts.size === 0) { last = null; dragging = false; kick(); }
    else { const p = [...pts.values()][0]; last = { x: p.x, y: p.y }; }
  }
  function onWheel(e) {
    e.preventDefault();
    fov = Math.max(35, Math.min(90, fov + e.deltaY * 0.04));
    tween = null;
    kick();
    userView();
  }
  function onKey(e) {
    if (e.key === 'Escape') { e.preventDefault(); if (!liftBox.hidden) closeLift(true); else close(); return; }
    const step = 0.08;
    if (e.key === 'ArrowLeft') yaw += step;
    else if (e.key === 'ArrowRight') yaw -= step;
    else if (e.key === 'ArrowUp') pitch += step;
    else if (e.key === 'ArrowDown') pitch -= step;
    else if (e.key === 'Tab') { // the dialog's controls in a ring: close, then the direction buttons
      e.preventDefault();
      const shown = (b) => b && b.isConnected && !b.disabled && b.getClientRects().length > 0;
      const ring = liftBtns.length ? liftBtns.filter(shown) // the lift's list holds the focus while it is open
        : [x, ...(backBtn ? [backBtn] : []), ...placeBtns.map((q) => q.b), ...doorEls.map((d) => d.el), ...ctrls].filter(shown);
      if (!ring.length) return;
      const i = ring.indexOf(document.activeElement);
      ring[(i + (e.shiftKey ? ring.length - 1 : 1)) % ring.length].focus();
      return;
    }
    else return;
    e.preventDefault();
    tween = null;
    if (!moved) { moved = true; root.classList.add('is-moved'); }
    kick();
    userView();
  }
  stage.addEventListener('pointerdown', onDown);
  stage.addEventListener('pointermove', onMove);
  stage.addEventListener('pointerup', onUp);
  stage.addEventListener('pointercancel', onUp);
  stage.addEventListener('wheel', onWheel, { passive: false });
  document.addEventListener('keydown', onKey);
  x.addEventListener('click', () => close());

  function close() {
    if (!alive) return;
    alive = false;
    if (raf) cancelAnimationFrame(raf);
    if (viewT) clearTimeout(viewT);
    ro.disconnect();
    if (placesRo) placesRo.disconnect();
    document.removeEventListener('keydown', onKey);
    if (phoneMq && phoneMq.removeEventListener) phoneMq.removeEventListener('change', placeStyles);
    if (pre) { pre.t.dispose(); pre = null; }
    if (mat.map) mat.map.dispose();
    mat.dispose();
    geo.dispose();
    renderer.dispose();
    root.remove();
    document.documentElement.classList.remove('nlat-open');
    if (prevFocus && prevFocus.focus) prevFocus.focus();
    if (typeof o.onClose === 'function') o.onClose();
    if (window.__nlTour === api) window.__nlTour = null;
    window.dispatchEvent(new CustomEvent('nl:tour', { detail: { open: false } }));
  }
  x.focus();
  /* the shared viewing room: set the look from outside (a scene switch included), and a direction to the screen and back */
  function setView(v, dur) {
    if (!alive || !v) return false;
    if (v.scene && v.scene !== cur.id) { const sc = scenes.find((x2) => x2.id === v.scene); if (sc) show(sc, 'api'); }
    if (v.style && v.style !== style) applyStyle(String(v.style), 'api');
    const y1 = Number(v.yaw), p1 = Number(v.pitch), f1 = Number(v.fov);
    const Y = Number.isFinite(y1) ? y1 : yaw;
    const P = Number.isFinite(p1) ? Math.max(-1.45, Math.min(1.45, p1)) : pitch;
    const F = Number.isFinite(f1) ? Math.max(35, Math.min(90, f1)) : fov;
    vy = vp = 0;
    const ms = Math.max(0, Number(dur) || 0) * 1000;
    if (!ms || reducedMotion) { tween = null; yaw = Y; pitch = P; fov = F; kick(); return true; }
    let dy = Y - yaw; dy = Math.atan2(Math.sin(dy), Math.cos(dy)); // the short way round
    tween = { t0: performance.now(), ms, y0: yaw, dy, p0: pitch, p1: P, f0: fov, f1: F };
    kick();
    return true;
  }
  const projV = new THREE.Vector3();
  function project(p) {
    if (!alive || !p) return null;
    const y1 = Number(p.yaw), p1 = Number(p.pitch);
    if (!Number.isFinite(y1) || !Number.isFinite(p1)) return null;
    projV.set(-Math.cos(y1) * Math.cos(p1), Math.sin(p1), Math.sin(y1) * Math.cos(p1)).multiplyScalar(100).project(camera);
    const r = stage.getBoundingClientRect();
    return { x: r.left + (projV.x * 0.5 + 0.5) * r.width, y: r.top + (-projV.y * 0.5 + 0.5) * r.height, behind: projV.z > 1 };
  }
  function pickLook(clientX, clientY) {
    if (!alive) return null;
    const r = stage.getBoundingClientRect();
    if (!r.width || !r.height) return null;
    projV.set(((clientX - r.left) / r.width) * 2 - 1, -((clientY - r.top) / r.height) * 2 + 1, 0.5).unproject(camera).normalize();
    return { yaw: +Math.atan2(projV.z, -projV.x).toFixed(4), pitch: +Math.asin(Math.max(-1, Math.min(1, projV.y))).toFixed(4) };
  }
  const api = { close, show: (id) => { const sc = scenes.find((x2) => x2.id === id); if (sc) show(sc); }, get scene() { return cur.id; },
    get yaw() { return yaw; }, get pitch() { return pitch; }, get fov() { return fov; }, get style() { return style; }, setStyle: (id) => applyStyle(id),
    getView, setView, project, pick: pickLook, get scenes() { return scenes.map((sc) => ({ id: sc.id, dir: sc.dir, spot: sc.spot, floor: sc.floor })); } };
  root.nlTour = api; // for the page's checks (scripts/project-stage/pagejourney.py)
  window.__nlTour = api; // the shared viewing room
  window.dispatchEvent(new CustomEvent('nl:tour', { detail: { open: true, scene: cur.id } }));
  return api;
}
