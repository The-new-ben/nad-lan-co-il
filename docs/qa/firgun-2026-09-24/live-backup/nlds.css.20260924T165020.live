/* NadLan design system for the site: tokens + components. Source: Claude Design artifact L9Nqz7Viv7K3MYeZrBc9s8.
   Built by scripts/nlds/build_nlds_css.py; do not edit by hand. Scoped under .nlds, shielded from the theme. */
:root{--nlds-sa-paper:#f7f6f2;--nlds-sa-surf:#ffffff;--nlds-sa-ink:#14212b;--nlds-sa-ink2:#3b4753;--nlds-sa-mute:#6b7680;--nlds-sa-line:#e3e1da;--nlds-sa-sea:#2f6f86;--nlds-sa-seah:#255c70;--nlds-sa-deep:#1f4b5c;--nlds-sa-sand:#eee9dd;--nlds-nl-champagne:#cfe3ea;--nlds-on-sea:var(--nlds-sa-surf);--nlds-chart-mid:#7fa7b5;--nlds-scrim:rgba(20,33,43,.72);--nlds-link-underline:rgba(47,111,134,.4);--nlds-on-deep-line:rgba(247,246,242,.16);--nlds-nlx-on-deep-2:rgba(247,246,242,.74);--nlds-nlx-on-deep-fill:rgba(247,246,242,.08);--nlds-bar-ground:rgba(247,246,242,.97);--nlds-on-deep-outline:rgba(247,246,242,.45);--nlds-wa-green:#0f7a63;--nlds-nlb-abyss:#10262f;--nlds-nlb-foam:#e8f1f3;--nlds-nlb-mute:#5f6b75;--nlds-nlb-line-hover:#d6d3ca;--nlds-nlb-ask-line:#aeb8bf;--nlds-field-ground:#fbfaf7;--nlds-j-bad:#b3261e;--nlds-j-bad-ground:#fbedec;--nlds-j-ok:#2e7d5b;--nlds-j-ok-ground:#eaf4ef;--nlds-focus-ring:var(--nlds-sa-sea);--nlds-space-4:4px;--nlds-space-6:6px;--nlds-space-8:8px;--nlds-space-10:10px;--nlds-space-12:12px;--nlds-space-14:14px;--nlds-space-16:16px;--nlds-space-18:18px;--nlds-space-20:20px;--nlds-space-22:22px;--nlds-space-26:26px;--nlds-space-32:32px;--nlds-space-34:34px;--nlds-space-40:40px;--nlds-radius-pill:999px;--nlds-radius-22:22px;--nlds-radius-18:18px;--nlds-radius-16:16px;--nlds-radius-14:14px;--nlds-radius-12:12px;--nlds-radius-11:11px;--nlds-radius-10:10px;--nlds-radius-8:8px;--nlds-radius-7:7px;--nlds-radius-6:6px;--nlds-shadow-card-hover:0 12px 30px rgba(20,33,43,.08);--nlds-shadow-float:0 14px 34px rgba(20,33,43,.1);--nlds-shadow-lcard-hover:0 18px 40px rgba(16,38,47,.10), 0 3px 10px rgba(16,38,47,.05);--nlds-shadow-price-card:0 8px 24px rgba(17,17,15,.07), 0 2px 6px rgba(17,17,15,.04);--nlds-shadow-hairline:0 1px 2px rgba(20,33,43,.04);--nlds-shadow-wa:0 10px 24px rgba(15,122,99,.30);--nlds-container:1240px;--nlds-container-home:1280px;--nlds-container-minisite:1440px;--nlds-header-height:72px;--nlds-tap-target:44px;--nlds-field-height:48px;--nlds-search-height:54px;--nlds-button-height:52px;--nlds-button-height-bar:48px;--nlds-measure-lead:60ch;--nlds-measure-prose:66ch;--nlds-focus-width:2px;--nlds-focus-offset:3px;--nlds-focus-width-field:3px;--nlds-focus-offset-field:1px;--nlds-font-serif:"Noto Serif Hebrew", "David Libre", Georgia, serif;--nlds-font-sans:Assistant, "Segoe UI", Arial, sans-serif}
:root body .nlds{font-family:var(--nlds-font-sans) !important;color:var(--nlds-sa-ink) !important;direction:rtl !important;line-height:1.5 !important;-webkit-font-smoothing:antialiased !important;text-rendering:optimizeLegibility !important}
:root body .nlds *,:root body .nlds *::before,:root body .nlds *::after{box-sizing:border-box !important}
:root body .nlds :is(img){max-width:100% !important;display:block !important}
:root body .nlds :is(p, h1, h2, h3, ul, dl, dd, figure){margin:0 !important}
:root body .nlds :is(ul){padding:0 !important;list-style:none !important}
:root body .nlds ::selection{background:var(--nlds-nl-champagne) !important}
:root body .nlds .nlds-num{font-variant-numeric:tabular-nums lining-nums !important;font-feature-settings:"tnum" 1, "lnum" 1 !important;direction:ltr !important;unicode-bidi:isolate !important;display:inline-block !important}
:root body .nlds .nlds-kicker{font-size:13px !important;font-weight:700 !important;letter-spacing:.04em !important;line-height:1.3 !important;color:var(--nlds-sa-sea) !important;margin:0 !important}
:root body .nlds .nlds-sample{display:inline-block !important;font-size:11.5px !important;font-weight:600 !important;line-height:1.6 !important;color:var(--nlds-sa-ink2) !important;background:var(--nlds-sa-sand) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-6) !important;padding:0 8px !important}
:root body .nlds .nlds-ico{width:18px !important;height:18px !important;flex:none !important;display:block !important}
:root body .nlds [dir="rtl"] .nlds-ico--forward,:root body .nlds[dir="rtl"] .nlds-ico--forward{transform:scaleX(-1) !important}
:root body .nlds a:focus-visible,:root body .nlds button:focus-visible,:root body .nlds .is-focus{outline:var(--nlds-focus-width) solid var(--nlds-focus-ring) !important;outline-offset:var(--nlds-focus-offset) !important}
:root body .nlds .nlds-btn{display:inline-flex !important;align-items:center !important;justify-content:center !important;gap:var(--nlds-space-8) !important;min-height:var(--nlds-button-height) !important;padding:0 26px !important;border-radius:var(--nlds-radius-pill) !important;border:1px solid transparent !important;font-family:var(--nlds-font-sans) !important;font-size:16px !important;font-weight:700 !important;line-height:1 !important;white-space:nowrap !important;text-decoration:none !important;cursor:pointer !important;transition:background .2s ease, color .2s ease, border-color .2s ease !important}
:root body .nlds .nlds-btn .nlds-ico{width:19px !important;height:19px !important}
:root body .nlds .nlds-btn--primary{background:var(--nlds-sa-sea) !important;border-color:var(--nlds-sa-sea) !important;color:var(--nlds-on-sea) !important}
:root body .nlds .nlds-btn--primary:hover,:root body .nlds .nlds-btn--primary.is-hover{background:var(--nlds-sa-seah) !important;border-color:var(--nlds-sa-seah) !important}
:root body .nlds .nlds-btn--secondary{background:var(--nlds-sa-surf) !important;border-color:var(--nlds-sa-line) !important;color:var(--nlds-sa-deep) !important}
:root body .nlds .nlds-btn--secondary:hover,:root body .nlds .nlds-btn--secondary.is-hover{background:var(--nlds-sa-sand) !important}
:root body .nlds .nlds-btn--line{background:transparent !important;border-color:var(--nlds-sa-ink) !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-btn--line:hover,:root body .nlds .nlds-btn--line.is-hover{background:var(--nlds-sa-ink) !important;color:var(--nlds-sa-paper) !important}
:root body .nlds .nlds-btn--quiet{min-height:var(--nlds-tap-target) !important;padding:0 !important;background:transparent !important;color:var(--nlds-sa-sea) !important;font-size:15px !important}
:root body .nlds .nlds-btn--quiet:hover,:root body .nlds .nlds-btn--quiet.is-hover{color:var(--nlds-sa-seah) !important}
:root body .nlds .nlds-btn--paper{background:var(--nlds-sa-paper) !important;border-color:var(--nlds-sa-paper) !important;color:var(--nlds-sa-deep) !important}
:root body .nlds .nlds-btn--ghost{background:transparent !important;border-color:var(--nlds-on-deep-outline) !important;color:var(--nlds-sa-paper) !important}
:root body .nlds .nlds-btn--sm{min-height:var(--nlds-tap-target) !important;padding:0 12px !important;font-size:15px !important}
:root body .nlds .nlds-btn--sm .nlds-ico{width:17px !important;height:17px !important}
:root body .nlds .nlds-btn--block{width:100% !important}
:root body .nlds .nlds-btn[disabled],:root body .nlds .nlds-btn.is-disabled{opacity:.6 !important;cursor:default !important}
:root body .nlds .nlds-band-deep{background:var(--nlds-sa-deep) !important;border-radius:var(--nlds-radius-22) !important;padding:var(--nlds-space-22) !important;color:var(--nlds-sa-paper) !important}
:root body .nlds .nlds-band-deep .nlds-note{color:var(--nlds-nl-champagne) !important}
:root body .nlds .nlds-btn--paper .nlds-ico{color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-wa-stage{position:relative !important;height:96px !important;border:1px dashed var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-12) !important;background:var(--nlds-sa-surf) !important}
:root body .nlds .nlds-wa{position:absolute !important;bottom:20px !important;inset-inline-end:20px !important;display:flex !important;align-items:center !important;gap:10px !important;min-height:54px !important;padding:8px 14px !important;border-radius:var(--nlds-radius-pill) !important;background:var(--nlds-wa-green) !important;box-shadow:var(--nlds-shadow-wa) !important;text-decoration:none !important;font-family:var(--nlds-font-sans) !important;transition:transform .2s, filter .2s !important}
:root body .nlds .nlds-wa:hover{transform:translateY(-3px) !important;filter:brightness(1.06) !important}
:root body .nlds .nlds-wa__glyph{display:grid !important;place-items:center !important;width:34px !important;height:34px !important;border-radius:50% !important;background:rgba(255, 255, 255, .18) !important;flex:0 0 auto !important}
:root body .nlds .nlds-wa__txt{display:flex !important;flex-direction:column !important;line-height:1.15 !important;color:var(--nlds-sa-surf) !important;white-space:nowrap !important}
:root body .nlds .nlds-wa__txt b{font:800 15px/1.2 var(--nlds-font-sans) !important;color:var(--nlds-sa-surf) !important}
:root body .nlds .nlds-wa__txt small{font:500 11px/1.2 var(--nlds-font-sans) !important;color:var(--nlds-sa-surf) !important;margin-top:2px !important}
:root body .nlds .nlds-wa__brand{display:grid !important;place-items:center !important;flex:0 0 auto !important;border-radius:7px !important;overflow:hidden !important;line-height:0 !important}
@media (prefers-reduced-motion: reduce){:root body .nlds .nlds-wa{transition:none !important}
:root body .nlds .nlds-wa:hover{transform:none !important}}
:root body .nlds .nlds-chip{display:inline-flex !important;align-items:center !important;gap:7px !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-pill) !important;background:var(--nlds-sa-surf) !important;color:var(--nlds-sa-ink) !important;font-family:var(--nlds-font-sans) !important;text-decoration:none !important;white-space:nowrap !important;cursor:pointer !important;transition:border-color .2s, color .2s, background .2s !important}
:root body .nlds .nlds-chip--filter{padding:9px 15px !important;font-size:13.5px !important;font-weight:600 !important}
:root body .nlds .nlds-chip--filter .nlds-chip__mark{width:16px !important;height:16px !important}
:root body .nlds .nlds-chip--filter i{font-style:normal !important;font-size:11px !important;line-height:1.5 !important;color:var(--nlds-sa-ink2) !important;background:var(--nlds-sa-sand) !important;padding:1px 7px !important;border-radius:20px !important}
:root body .nlds .nlds-chip--filter:hover,:root body .nlds .nlds-chip--filter.is-hover{border-color:var(--nlds-sa-sea) !important;color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-chip--filter[aria-pressed="true"]{background:var(--nlds-sa-sea) !important;border-color:var(--nlds-sa-sea) !important;color:var(--nlds-on-sea) !important}
:root body .nlds .nlds-chip--filter[aria-pressed="true"] i{color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-chip--link{padding:7px 13px !important;font-size:14px !important}
:root body .nlds .nlds-chip--link:hover,:root body .nlds .nlds-chip--link.is-hover{border-color:var(--nlds-sa-sea) !important;color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-chip--feature{align-items:flex-start !important;gap:9px !important;min-height:56px !important;padding:10px 14px 10px 12px !important;background:var(--nlds-sa-paper) !important;white-space:normal !important}
:root body .nlds .nlds-chip--feature .nlds-chip__icon{display:grid !important;place-items:center !important;width:30px !important;height:30px !important;border-radius:50% !important;background:var(--nlds-sa-sand) !important;flex:none !important}
:root body .nlds .nlds-chip--feature .nlds-chip__icon img{width:18px !important;height:18px !important}
:root body .nlds .nlds-chip--feature b{display:block !important;font-size:13px !important;font-weight:700 !important;line-height:1.35 !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-chip--feature s{display:block !important;text-decoration:none !important;font-size:11.5px !important;line-height:1.45 !important;color:var(--nlds-sa-ink2) !important;margin-top:2px !important}
:root body .nlds .nlds-chip--feature:hover,:root body .nlds .nlds-chip--feature.is-hover{border-color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-chip--fact{cursor:default !important;gap:6px !important;padding:5px 12px !important;background:var(--nlds-sa-sand) !important;color:var(--nlds-sa-deep) !important;font-size:14px !important;font-weight:600 !important;line-height:1.3 !important}
:root body .nlds .nlds-chips{display:flex !important;flex-wrap:wrap !important;gap:var(--nlds-space-8) !important}
:root body .nlds .nlds-licence{display:inline-flex !important;align-items:baseline !important;flex-wrap:nowrap !important;gap:5px !important;font-size:13px !important;line-height:1.45 !important;font-weight:700 !important;color:var(--nlds-sa-deep) !important}
:root body .nlds .nlds-licence__check{color:var(--nlds-sa-sea) !important;font-weight:700 !important;flex:none !important}
:root body .nlds .nlds-licence > span:last-child{min-width:0 !important}
:root body .nlds .nlds-licence--plain{font-weight:600 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-licence--pill{padding:3px 11px !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-pill) !important;background:var(--nlds-sa-sand) !important;font-size:12.5px !important}
:root body .nlds .nlds-licence--line{font-size:14px !important;font-weight:400 !important;line-height:1.55 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-pagehead{display:grid !important;gap:0 !important;padding-block:var(--nlds-space-34) var(--nlds-space-26) !important}
:root body .nlds .nlds-pagehead--panel{background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-22) !important;padding:clamp(22px, 3vw, 40px) !important}
:root body .nlds .nlds-crumbs{display:flex !important;flex-wrap:wrap !important;align-items:center !important;gap:0 !important;margin-bottom:var(--nlds-space-16) !important;font-size:13px !important;font-weight:700 !important;letter-spacing:.04em !important;line-height:1.3 !important}
:root body .nlds .nlds-crumbs a{color:var(--nlds-sa-sea) !important;text-decoration:none !important}
:root body .nlds .nlds-crumbs a:hover{color:var(--nlds-sa-seah) !important;text-decoration:underline !important;text-decoration-color:var(--nlds-link-underline) !important}
:root body .nlds .nlds-crumbs [aria-current="page"]{color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-crumbs__sep{margin:0 6px !important;color:var(--nlds-sa-ink2) !important;font-weight:400 !important}
:root body .nlds .nlds-pagehead__title{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:clamp(30px, 3.4vw, 46px) !important;line-height:1.1 !important;letter-spacing:-.005em !important;color:var(--nlds-sa-ink) !important;margin:0 0 12px !important;text-wrap:balance !important}
:root body .nlds .nlds-pagehead__lead{font-size:clamp(16px, 1.25vw, 18.5px) !important;line-height:1.55 !important;color:var(--nlds-sa-ink2) !important;max-width:var(--nlds-measure-lead) !important}
:root body .nlds .nlds-lgrid{display:grid !important;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)) !important;column-gap:var(--nlds-space-32) !important;row-gap:36px !important;align-items:start !important}
:root body .nlds .nlds-lcard{position:relative !important;display:flex !important;flex-direction:column !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-10) !important;overflow:hidden !important;transition:box-shadow .25s ease, border-color .25s ease !important}
:root body .nlds .nlds-lcard:hover,:root body .nlds .nlds-lcard.is-hover{box-shadow:var(--nlds-shadow-lcard-hover) !important;border-color:var(--nlds-nlb-line-hover) !important}
:root body .nlds .nlds-lcard > *:not(.nlds-lcard__media){padding-inline:var(--nlds-space-22) !important}
:root body .nlds .nlds-lcard__media{position:relative !important;display:block !important;aspect-ratio:4/5 !important;background:var(--nlds-nlb-abyss) !important;overflow:hidden !important}
:root body .nlds .nlds-lcard__media img{position:absolute !important;inset:0 !important;width:100% !important;height:100% !important;object-fit:cover !important;object-position:center !important;transition:transform .6s ease !important}
:root body .nlds .nlds-lcard:hover .nlds-lcard__media img{transform:scale(1.03) !important}
:root body .nlds .nlds-lcard__badges{position:absolute !important;top:14px !important;inset-inline-start:14px !important;inset-inline-end:64px !important;display:flex !important;flex-wrap:wrap !important;gap:6px !important}
:root body .nlds .nlds-badge{display:inline-flex !important;align-items:center !important;height:28px !important;padding:0 12px !important;border-radius:var(--nlds-radius-pill) !important;font-size:13px !important;font-weight:700 !important;white-space:nowrap !important}
:root body .nlds .nlds-badge--sale{background:var(--nlds-nlb-abyss) !important;color:var(--nlds-sa-paper) !important}
:root body .nlds .nlds-badge--rent{background:var(--nlds-sa-paper) !important;color:var(--nlds-nlb-abyss) !important}
:root body .nlds .nlds-badge--note{background:var(--nlds-nl-champagne) !important;color:var(--nlds-nlb-abyss) !important}
:root body .nlds .nlds-lcard__kicker{padding-top:var(--nlds-space-22) !important;font-size:13px !important;line-height:1.3 !important;font-weight:700 !important;letter-spacing:.02em !important;color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-lcard__title{padding-top:var(--nlds-space-8) !important;font-family:var(--nlds-font-serif) !important;font-size:22px !important;line-height:1.3 !important;font-weight:500 !important;color:var(--nlds-sa-ink) !important;text-wrap:balance !important}
:root body .nlds .nlds-lcard__title a{color:inherit !important;text-decoration:none !important}
:root body .nlds .nlds-lcard__title a::after{content:"" !important;position:absolute !important;inset:0 !important;z-index:0 !important}
:root body .nlds .nlds-lcard__title a:hover{color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-lcard__price{padding-top:var(--nlds-space-12) !important;display:flex !important;flex-direction:column !important;justify-content:center !important;gap:4px !important;min-height:70px !important}
:root body .nlds .nlds-lcard__price strong{display:flex !important;align-items:baseline !important;gap:var(--nlds-space-8) !important;font-size:27px !important;line-height:1.15 !important;font-weight:800 !important;color:var(--nlds-sa-ink) !important;white-space:nowrap !important}
:root body .nlds .nlds-lcard__price strong small{font-size:15px !important;font-weight:600 !important;color:var(--nlds-nlb-mute) !important}
:root body .nlds .nlds-lcard__price > span{font-size:14px !important;line-height:1.3 !important;color:var(--nlds-nlb-mute) !important}
:root body .nlds .nlds-lcard__specs{margin:var(--nlds-space-16) var(--nlds-space-22) 0 !important;padding:var(--nlds-space-16) 0 0 !important;border-top:1px solid var(--nlds-sa-line) !important;display:grid !important;grid-template-columns:repeat(2, minmax(0, 1fr)) !important;gap:10px 14px !important}
:root body .nlds .nlds-lcard__specs li{display:flex !important;align-items:center !important;gap:var(--nlds-space-8) !important;min-width:0 !important;font-size:15px !important;line-height:1.3 !important;font-weight:600 !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-lcard__hi{padding-top:var(--nlds-space-16) !important;display:flex !important;flex-direction:column !important;gap:5px !important}
:root body .nlds .nlds-lcard__hi li{position:relative !important;padding-inline-start:15px !important;font-size:14.5px !important;line-height:1.45 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-lcard__hi li::before{content:"" !important;position:absolute !important;inset-inline-start:0 !important;top:.56em !important;width:5px !important;height:5px !important;border-radius:50% !important;background:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-lcard__amen{padding-top:var(--nlds-space-14) !important;display:flex !important;flex-wrap:wrap !important;gap:6px !important}
:root body .nlds .nlds-lcard__amen span{display:inline-flex !important;align-items:center !important;gap:6px !important;height:28px !important;padding:0 10px !important;border-radius:var(--nlds-radius-pill) !important;background:var(--nlds-nlb-foam) !important;color:var(--nlds-sa-deep) !important;font-size:13px !important;font-weight:600 !important;white-space:nowrap !important}
:root body .nlds .nlds-lcard__amen .nlds-ico{width:14px !important;height:14px !important}
:root body .nlds .nlds-lcard__meta > span{white-space:nowrap !important}
:root body .nlds .nlds-lcard__meta{margin:var(--nlds-space-16) var(--nlds-space-22) 0 !important;padding:var(--nlds-space-12) 0 0 !important;border-top:1px solid var(--nlds-sa-line) !important;display:flex !important;align-items:center !important;justify-content:space-between !important;gap:var(--nlds-space-12) !important;font-size:13px !important;color:var(--nlds-nlb-mute) !important}
:root body .nlds .nlds-lcard__meta > span:first-child{display:flex !important;align-items:center !important;gap:7px !important;font-size:14px !important;font-weight:600 !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-lcard__meta .nlds-ico{width:16px !important;height:16px !important}
:root body .nlds .nlds-lcard__cta{position:relative !important;z-index:1 !important;padding-block:var(--nlds-space-14) var(--nlds-space-22) !important;display:grid !important;grid-template-columns:repeat(2, minmax(0, 1fr)) !important;gap:var(--nlds-space-10) !important;margin-top:auto !important}
:root body .nlds .nlds-pgrid{display:grid !important;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)) !important;gap:var(--nlds-space-18) !important;align-items:start !important}
:root body .nlds .nlds-pcard{position:relative !important;display:flex !important;flex-direction:column !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-16) !important;padding:var(--nlds-space-12) !important;transition:transform .15s, box-shadow .15s !important}
:root body .nlds .nlds-pcard:hover,:root body .nlds .nlds-pcard.is-hover{transform:translateY(-2px) !important;box-shadow:var(--nlds-shadow-card-hover) !important}
:root body .nlds .nlds-pcard__media{position:relative !important;display:block !important;border-radius:var(--nlds-radius-12) !important;overflow:hidden !important;background:var(--nlds-sa-sand) !important;aspect-ratio:4/3 !important}
:root body .nlds .nlds-pcard__media img{width:100% !important;height:100% !important;object-fit:cover !important}
:root body .nlds .nlds-pcard__cap{position:absolute !important;right:12px !important;bottom:10px !important;background:var(--nlds-scrim) !important;color:var(--nlds-sa-paper) !important;font-size:12px !important;line-height:1.4 !important;padding:5px 10px !important;border-radius:var(--nlds-radius-6) !important}
:root body .nlds .nlds-pcard__type{position:absolute !important;top:12px !important;inset-inline-start:12px !important;background:var(--nlds-sa-surf) !important;color:var(--nlds-sa-ink) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-pill) !important;font-size:11px !important;font-weight:600 !important;padding:4px 10px !important}
:root body .nlds .nlds-pcard__body{display:flex !important;flex-direction:column !important;gap:6px !important;padding:14px 6px 6px !important}
:root body .nlds .nlds-pcard__title{font-family:var(--nlds-font-serif) !important;font-size:22px !important;line-height:1.2 !important;font-weight:600 !important;letter-spacing:-.005em !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-pcard__title a{color:inherit !important;text-decoration:none !important}
:root body .nlds .nlds-pcard__title a::after{content:"" !important;position:absolute !important;inset:0 !important}
:root body .nlds .nlds-pcard__text{font-size:15px !important;line-height:1.5 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-pcard__link{position:relative !important;z-index:1 !important;margin-top:6px !important;font-weight:700 !important;color:var(--nlds-sa-sea) !important;text-decoration:none !important}
:root body .nlds .nlds-pcard__facts{display:grid !important;grid-template-columns:repeat(3, minmax(0, 1fr)) !important;gap:var(--nlds-space-8) !important;margin-top:var(--nlds-space-8) !important;padding-top:13px !important;border-top:1px solid var(--nlds-sa-line) !important}
:root body .nlds .nlds-pcard__facts dt{margin:0 !important;font-size:11px !important;color:var(--nlds-sa-mute) !important}
:root body .nlds .nlds-pcard__facts dd{margin:2px 0 0 !important;font-size:14px !important;font-weight:600 !important;color:var(--nlds-sa-ink) !important;overflow:hidden !important;text-overflow:ellipsis !important;white-space:nowrap !important}
:root body .nlds .nlds-pcard__market{font-size:13px !important;line-height:1.5 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-pcard__market small{display:block !important;font-size:12px !important;color:var(--nlds-sa-mute) !important}
:root body .nlds .nlds-pcard__foot{position:relative !important;z-index:1 !important;display:flex !important;align-items:center !important;gap:var(--nlds-space-12) !important;margin-top:var(--nlds-space-8) !important}
:root body .nlds .nlds-pcard__foot .nlds-btn{flex:1 !important}
:root body .nlds .nlds-pcard__reg{display:inline-flex !important;align-items:center !important;gap:4px !important;font-size:12px !important;color:var(--nlds-sa-mute) !important;white-space:nowrap !important}
:root body .nlds .nlds-pcard__reg img{width:14px !important;height:14px !important}
:root body .nlds .nlds-dgrid{display:grid !important;grid-template-columns:repeat(auto-fill, minmax(248px, 1fr)) !important;gap:var(--nlds-space-16) !important;align-items:start !important}
:root body .nlds .nlds-procard{position:relative !important;display:flex !important;flex-direction:column !important;gap:11px !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-16) !important;padding:var(--nlds-space-20) !important;color:inherit !important;text-decoration:none !important;transition:transform .22s cubic-bezier(.2, .8, .2, 1), box-shadow .22s, border-color .22s !important}
:root body .nlds .nlds-procard:hover,:root body .nlds .nlds-procard.is-hover{transform:translateY(-3px) !important;border-color:var(--nlds-sa-sea) !important;box-shadow:var(--nlds-shadow-float) !important}
:root body .nlds .nlds-procard__top{display:flex !important;gap:13px !important;align-items:flex-start !important}
:root body .nlds .nlds-procard__av{flex:none !important;width:56px !important;height:56px !important;border-radius:var(--nlds-radius-14) !important;display:grid !important;place-items:center !important;background:var(--nlds-sa-sand) !important;border:1px solid var(--nlds-sa-line) !important}
:root body .nlds .nlds-procard__av img{width:32px !important;height:32px !important}
:root body .nlds .nlds-procard__id{min-width:0 !important;flex:1 !important}
:root body .nlds .nlds-procard__name{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:17px !important;line-height:1.25 !important;margin:0 0 7px !important;color:var(--nlds-sa-ink) !important;overflow:hidden !important;display:-webkit-box !important;-webkit-line-clamp:2 !important;-webkit-box-orient:vertical !important}
:root body .nlds .nlds-procard__pill{display:inline-block !important;color:var(--nlds-sa-sea) !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-pill) !important;padding:2px 10px !important;font-size:11.5px !important;font-weight:700 !important}
:root body .nlds .nlds-procard__meta{display:flex !important;flex-direction:column !important;gap:5px !important;font-size:13px !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-procard__city{display:inline-flex !important;align-items:center !important;gap:5px !important;font-weight:600 !important}
:root body .nlds .nlds-procard__city img{width:16px !important;height:16px !important}
:root body .nlds .nlds-procard__foot{margin-top:auto !important;display:flex !important;align-items:center !important;justify-content:space-between !important;gap:var(--nlds-space-8) !important;padding-top:11px !important;border-top:1px solid var(--nlds-sa-line) !important}
:root body .nlds .nlds-procard__go{color:var(--nlds-sa-sea) !important;font-weight:700 !important;font-size:13px !important;white-space:nowrap !important}
:root body .nlds .nlds-procard--compact{align-items:center !important;text-align:center !important;gap:6px !important;border-radius:var(--nlds-radius-12) !important;padding:16px 10px !important}
:root body .nlds .nlds-procard--compact svg{width:56px !important;height:56px !important}
:root body .nlds .nlds-procard--compact b{font-size:13.5px !important;line-height:1.2 !important}
:root body .nlds .nlds-procard--compact span{font-size:11.5px !important;color:var(--nlds-sa-mute) !important}
:root body .nlds .nlds-procard--compact:hover,:root body .nlds .nlds-procard--compact.is-hover{transform:none !important;box-shadow:none !important}
:root body .nlds .nlds-mono{width:44px !important;height:44px !important;border-radius:50% !important;background:var(--nlds-sa-deep) !important;color:var(--nlds-sa-paper) !important;display:grid !important;place-items:center !important;font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:18px !important;flex:none !important}
:root body .nlds .nlds-mono--lg{width:64px !important;height:64px !important;font-size:26px !important}
:root body .nlds .nlds-monogram circle.o{fill:var(--nlds-sa-surf) !important;stroke:var(--nlds-sa-line) !important;stroke-width:2 !important}
:root body .nlds .nlds-monogram circle.i{fill:var(--nlds-sa-deep) !important}
:root body .nlds .nlds-monogram path{fill:none !important;stroke:var(--nlds-sa-sea) !important;stroke-width:2.4 !important;stroke-linecap:round !important}
:root body .nlds .nlds-monogram text{fill:var(--nlds-sa-paper) !important;font-family:var(--nlds-font-serif) !important;font-size:30px !important;font-weight:700 !important}
:root body .nlds .nlds-bfeat{display:grid !important;grid-template-columns:200px minmax(0, 1fr) !important;gap:var(--nlds-space-22) !important;align-items:stretch !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-16) !important;padding:var(--nlds-space-22) !important;transition:border-color .22s, box-shadow .22s !important}
:root body .nlds .nlds-bfeat:hover,:root body .nlds .nlds-bfeat.is-hover{border-color:var(--nlds-sa-sea) !important;box-shadow:var(--nlds-shadow-float) !important}
:root body .nlds .nlds-bfeat__portrait{aspect-ratio:4/5 !important;border-radius:var(--nlds-radius-14) !important;overflow:hidden !important;background:var(--nlds-sa-sand) !important;display:grid !important;place-items:center !important;margin:0 !important}
:root body .nlds .nlds-bfeat__portrait img{width:100% !important;height:100% !important;object-fit:cover !important;object-position:50% 22% !important}
:root body .nlds .nlds-bfeat__portrait .nlds-mono{width:96px !important;height:96px !important;font-size:40px !important}
:root body .nlds .nlds-bfeat__body{display:flex !important;flex-direction:column !important;gap:var(--nlds-space-8) !important;min-width:0 !important}
:root body .nlds .nlds-bfeat__name{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:24px !important;line-height:1.25 !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-bfeat__name a{color:inherit !important;text-decoration:none !important}
:root body .nlds .nlds-bfeat__role{font-size:15px !important;line-height:1.5 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-bfeat__role b{color:var(--nlds-sa-ink) !important;font-weight:700 !important}
:root body .nlds .nlds-bfeat__count{display:flex !important;align-items:baseline !important;gap:6px !important;font-size:15px !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-bfeat__count b{font-size:23px !important;font-weight:700 !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-bfeat__cta{display:flex !important;flex-wrap:wrap !important;gap:var(--nlds-space-10) !important;margin-top:auto !important;padding-top:var(--nlds-space-8) !important}
:root body .nlds .nlds-profile{display:flex !important;align-items:center !important;gap:var(--nlds-space-18) !important;flex-wrap:wrap !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-14) !important;padding:var(--nlds-space-22) !important;box-shadow:var(--nlds-shadow-hairline) !important}
:root body .nlds .nlds-profile__portrait{width:88px !important;height:88px !important;flex-shrink:0 !important;border-radius:50% !important;object-fit:cover !important;object-position:50% 22% !important;border:2px solid var(--nlds-sa-deep) !important;background:var(--nlds-sa-surf) !important}
:root body .nlds .nlds-profile svg.nlds-monogram{width:88px !important;height:88px !important;flex-shrink:0 !important}
:root body .nlds .nlds-profile__id{flex:1 !important;min-width:200px !important}
:root body .nlds .nlds-profile__pill{display:inline-block !important;font-size:11.5px !important;font-weight:700 !important;color:var(--nlds-sa-deep) !important;background:var(--nlds-sa-sand) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-pill) !important;padding:4px 12px !important}
:root body .nlds .nlds-profile__name{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:1.7rem !important;line-height:1.15 !important;letter-spacing:-.005em !important;margin:8px 0 6px !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-profile__sub{display:flex !important;flex-wrap:wrap !important;align-items:baseline !important;gap:6px 12px !important;font-size:13px !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-profile__ctas{display:flex !important;gap:var(--nlds-space-8) !important;flex-wrap:wrap !important}
:root body .nlds .nlds-profile__ctas .nlds-btn{min-height:var(--nlds-tap-target) !important;padding:11px 18px !important;font-size:13.5px !important}
:root body .nlds .nlds-endorse{display:grid !important;gap:var(--nlds-space-16) !important}
:root body .nlds .nlds-endorse__head{display:flex !important;align-items:baseline !important;justify-content:space-between !important;gap:var(--nlds-space-12) !important;flex-wrap:wrap !important}
:root body .nlds .nlds-endorse__title{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:22px !important;line-height:1.2 !important;letter-spacing:-.005em !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-endorse__list{display:grid !important;grid-template-columns:repeat(3, minmax(0, 1fr)) !important;gap:var(--nlds-space-14) !important}
:root body .nlds .nlds-endorse__item{position:relative !important;display:flex !important;flex-direction:column !important;gap:var(--nlds-space-12) !important;background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-16) !important;padding:var(--nlds-space-18) !important}
:root body .nlds .nlds-endorse__who{display:flex !important;align-items:center !important;gap:var(--nlds-space-12) !important}
:root body .nlds .nlds-endorse__who a{color:var(--nlds-sa-ink) !important;font-weight:700 !important;font-size:15px !important;line-height:1.3 !important;text-decoration:none !important}
:root body .nlds .nlds-endorse__who a::after{content:"" !important;position:absolute !important;inset:0 !important;border-radius:var(--nlds-radius-16) !important}
:root body .nlds .nlds-endorse__item:hover{border-color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-endorse__who small{display:block !important;font-size:13px !important;line-height:1.4 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-endorse__line{font-size:15px !important;line-height:1.5 !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-form{background:var(--nlds-sa-surf) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-16) !important;padding:clamp(20px, 4vw, 36px) !important;max-width:760px !important;box-shadow:var(--nlds-shadow-hairline) !important}
:root body .nlds .nlds-form__title{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:24px !important;line-height:1.25 !important;margin:0 0 var(--nlds-space-12) !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-field{margin:0 0 var(--nlds-space-14) !important}
:root body .nlds .nlds-field label{display:block !important;font-weight:700 !important;font-size:15px !important;line-height:1.3 !important;color:var(--nlds-sa-ink) !important;margin:0 0 6px !important}
:root body .nlds .nlds-field__req{color:var(--nlds-sa-sea) !important;margin-inline-start:3px !important}
:root body .nlds .nlds-field__opt{font-weight:400 !important;color:var(--nlds-sa-mute) !important;font-size:13.5px !important}
:root body .nlds .nlds-field input,:root body .nlds .nlds-field textarea{width:100% !important;min-height:var(--nlds-field-height) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-10) !important;padding:10px 12px !important;font-family:var(--nlds-font-sans) !important;font-size:16px !important;background:var(--nlds-field-ground) !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-field textarea{min-height:84px !important;resize:vertical !important}
:root body .nlds .nlds-field input:focus,:root body .nlds .nlds-field textarea:focus,:root body .nlds .nlds-field .is-focus{outline:var(--nlds-focus-width-field) solid var(--nlds-focus-ring) !important;outline-offset:var(--nlds-focus-offset-field) !important;border-color:transparent !important}
:root body .nlds .nlds-field [aria-invalid="true"]{border-color:var(--nlds-j-bad) !important}
:root body .nlds .nlds-field__hint{margin:6px 0 0 !important;font-size:13.5px !important;line-height:1.5 !important;color:var(--nlds-sa-mute) !important}
:root body .nlds .nlds-consent{display:flex !important;gap:var(--nlds-space-10) !important;align-items:flex-start !important;font-weight:500 !important;font-size:14.5px !important;line-height:1.55 !important;margin:0 0 var(--nlds-space-10) !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-consent input{margin-top:4px !important;width:18px !important;height:18px !important;flex:0 0 auto !important;accent-color:var(--nlds-sa-sea) !important}
:root body .nlds .nlds-promise{display:flex !important;align-items:center !important;gap:6px !important;margin:var(--nlds-space-10) 0 0 !important;font-size:13.5px !important;color:var(--nlds-sa-ink2) !important}
:root body .nlds .nlds-promise img{width:16px !important;height:16px !important}
:root body .nlds .nlds-form .nlds-btn--primary{width:100% !important;margin-top:6px !important;font-size:17px !important;line-height:1.2 !important;padding:10px 26px !important}
:root body .nlds .nlds-msg{margin-top:var(--nlds-space-14) !important;padding:12px 14px !important;border-radius:var(--nlds-radius-10) !important;border:1px solid var(--nlds-j-bad) !important;background:var(--nlds-j-bad-ground) !important;color:var(--nlds-sa-ink) !important;font-size:15px !important;line-height:1.6 !important}
:root body .nlds .nlds-msg--ok{border-color:var(--nlds-j-ok) !important;background:var(--nlds-j-ok-ground) !important}
:root body .nlds .nlds-screen{position:relative !important;width:390px !important;max-width:100% !important;height:280px !important;overflow:hidden !important;background:var(--nlds-sa-paper) !important;border:1px solid var(--nlds-sa-line) !important;border-radius:var(--nlds-radius-22) !important}
:root body .nlds .nlds-screen__page{padding:var(--nlds-space-16) !important;display:grid !important;gap:var(--nlds-space-8) !important;color:var(--nlds-sa-ink) !important}
:root body .nlds .nlds-ibar{position:sticky !important;bottom:0 !important;z-index:30 !important;display:grid !important;grid-template-columns:minmax(0, 1fr) auto auto !important;gap:var(--nlds-space-10) !important;padding:12px 16px calc(16px + env(safe-area-inset-bottom, 0px)) !important;background:var(--nlds-bar-ground) !important;border-top:1px solid var(--nlds-sa-line) !important}
:root body .nlds .nlds-screen .nlds-ibar{position:absolute !important;inset-inline:0 !important;bottom:0 !important}
:root body .nlds .nlds-ibar .nlds-btn{min-height:var(--nlds-button-height-bar) !important;font-size:15px !important;padding:0 14px !important}
:root body .nlds .nlds-ibar .nlds-btn--primary{font-size:16px !important}
@media (min-width: 721px){:root body .nlds .nlds-ibar.is-live{display:none !important}}
:root body .nlds .nlds-sr{position:absolute !important;width:1px !important;height:1px !important;overflow:hidden !important;clip:rect(0 0 0 0) !important;white-space:nowrap !important}
:root body .nlds .nlds-screen--320{width:320px !important}
:root body .nlds .nlds-ibar--compact{grid-template-columns:minmax(0, 1fr) var(--nlds-button-height-bar) var(--nlds-button-height-bar) !important}
:root body .nlds .nlds-ibar--compact .nlds-btn--secondary{padding:0 !important}
:root body .nlds .nlds-ibar--compact .nlds-ibar__label{position:absolute !important;width:1px !important;height:1px !important;overflow:hidden !important;clip:rect(0 0 0 0) !important;white-space:nowrap !important}
@media (max-width: 360px){:root body .nlds .nlds-ibar{grid-template-columns:minmax(0, 1fr) var(--nlds-button-height-bar) var(--nlds-button-height-bar) !important}
:root body .nlds .nlds-ibar .nlds-btn--secondary{padding:0 !important}
:root body .nlds .nlds-ibar .nlds-ibar__label{position:absolute !important;width:1px !important;height:1px !important;overflow:hidden !important;clip:rect(0 0 0 0) !important;white-space:nowrap !important}}
@media print{:root body .nlds .nlds-ibar{display:none !important}}
@media (prefers-reduced-motion: reduce){:root body .nlds *:not(#nlds-rm){transition:none !important}}
:root body .nlds .nlds-video{display:grid !important;gap:var(--nlds-space-14) !important}
:root body .nlds .nlds-video__title{font-family:var(--nlds-font-serif) !important;font-weight:600 !important;font-size:24px !important;line-height:1.25 !important;letter-spacing:-.005em !important;color:var(--nlds-sa-ink) !important;margin:0 !important;text-wrap:balance !important}
:root body .nlds .nlds-video__frame{border-radius:var(--nlds-radius-16) !important;overflow:hidden !important;background:var(--nlds-sa-deep) !important;border:1px solid var(--nlds-sa-line) !important}
:root body .nlds .nlds-video__v{display:block !important;width:100% !important;height:auto !important;background:var(--nlds-sa-deep) !important}
:root body .nlds .nlds-video__v--tall{display:none !important}
:root body .nlds .nlds-video__stand{position:relative !important}
:root body .nlds .nlds-video__stand > span{position:absolute !important;inset:0 !important;display:flex !important;align-items:center !important;justify-content:center !important;gap:.3em !important;color:var(--nlds-sa-paper) !important;font-size:14px !important;font-weight:600 !important}
:root body .nlds .nlds-video__meta{font-size:14px !important;line-height:1.5 !important;color:var(--nlds-sa-ink2) !important;margin:0 !important}
/* site layer */
:root body .nlds{font-size:16px !important}
:root body .nlds :is(p, a, span, b, strong, em, i, small, time, label, li){font-family:inherit !important}
:root body .nlds .nlds-bfeat__portrait{min-width:0 !important;width:100% !important}
:root body .nlds .nlds-bfeat:has(> .nlds-bfeat__cta){grid-template-rows:minmax(0, 1fr) auto !important;row-gap:var(--nlds-space-8) !important}
:root body .nlds .nlds-bfeat:has(> .nlds-bfeat__cta) > .nlds-bfeat__portrait{grid-row:span 2 !important}
:root body .nlds .nlds-bfeat > .nlds-bfeat__cta{grid-column:2 !important;margin-top:0 !important}
/* phone: the artifact's .nlds-phone rules */
@media (max-width: 600px){
:root body .nlds .nlds-pagehead__title{font-size:30px !important}
:root body .nlds .nlds-pagehead__lead{font-size:16px !important}
:root body .nlds .nlds-bfeat{grid-template-columns:96px minmax(0, 1fr) !important;gap:var(--nlds-space-14) !important;padding:var(--nlds-space-16) !important}
:root body .nlds .nlds-bfeat__portrait .nlds-mono{width:56px !important;height:56px !important;font-size:24px !important}
:root body .nlds .nlds-bfeat__name{font-size:21px !important}
:root body .nlds .nlds-bfeat__cta{grid-column:1 / -1 !important}
:root body .nlds .nlds-bfeat__cta .nlds-btn{flex:1 !important;min-height:var(--nlds-tap-target) !important;padding:0 12px !important;font-size:15px !important}
:root body .nlds .nlds-profile{padding:var(--nlds-space-16) !important}
:root body .nlds .nlds-profile__name{font-size:1.4rem !important}
:root body .nlds .nlds-profile__ctas{width:100% !important}
:root body .nlds .nlds-profile__ctas .nlds-btn{flex:1 !important;justify-content:center !important;padding-inline:10px !important}
:root body .nlds .nlds-endorse__list{grid-template-columns:minmax(0, 1fr) !important}
:root body .nlds .nlds-video__v--tall{display:block !important;max-height:80vh !important}
:root body .nlds .nlds-video__v--wide{display:none !important}
:root body .nlds .nlds-bfeat:has(> .nlds-bfeat__cta){grid-template-rows:none !important;row-gap:var(--nlds-space-14) !important}
:root body .nlds .nlds-bfeat:has(> .nlds-bfeat__cta) > .nlds-bfeat__portrait{grid-row:auto !important;align-self:start !important}
:root body .nlds .nlds-bfeat > .nlds-bfeat__cta{grid-column:1 / -1 !important;padding-top:0 !important}
:root body .nlds .nlds-bfeat .nlds-chips{display:none !important}
}
