{
 "project": "Kikar Hamedina (nad-lan.co.il/projects/hamedina/), film V6 (HAD-380): the frames pack",
 "made": "2026-10-02 21:13",
 "by": "Claude (capture helper); the editor (Maya, DaVinci) cuts, voices and captions; no edit, voice or music here",
 "source": "the live pages https://nad-lan.co.il/projects/hamedina/ (he) and /projects/hamedina-en/ (en), plugin 1.72.395, read-only; captured in a Playwright Chrome (ANGLE/WebGL) with a virtual clock: the page's clock advances exactly 1/30 s per frame, so the motion is even at 30 fps however long a frame takes to capture. The site's header, WhatsApp bar and accessibility button are hidden in the capture browser only; world.js was served to the capture browser with adaptive resolution off and pixel ratio up to 2 (render quality only).",
 "fps": 30,
 "formats": "16x9: PNG sequences (0001.png..), 1920x1080. 9x16: 1080x1920 H.264 mp4 (CRF 12, yuv420p, 30 fps) + poster.png, because PNG for both framings would pass ~3 GB. The world-view clips have no on-screen text except pick and around (the picker UI and the place labels), which exist in he and en.",
 "script_shots": {
  "1": "fly-in",
  "2": "pick (he) / pick-en",
  "3": "window-day/sunset/evening (the world's view from floor 30 north-west) or window-album-* (the album's rendered stills, west)",
  "4": "styles-original / warm-wood / light / stone",
  "5": "building-lobby / pool / gym / spa / parking",
  "6": "around-outdoors (parks & sport) and around-food (cafes & dining): the category icons on the map, he and en; around-*-names-16x9 = extras with the name cards (business/chain names: review before use)",
  "7": "no clip of its own: the last ~4 s of pick show the apartment card with the published deals (9.58-10.63 million)",
  "8": "no clip (the call to action is the editor's caption/voice)"
 },
 "not_captured": [
  "the lift (no 360 scene of its own; it is a control in the 360 viewer)"
 ],
